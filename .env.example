# Supabase (create a free project at https://supabase.com → copy these)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # service_role key — server only, NEVER expose to browser

# Admin dashboard password (you choose; used as Bearer token for /api/admin/*)
ADMIN_PASSWORD=change-me-to-something-long
